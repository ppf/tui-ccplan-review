#!/bin/bash
# Launch plan review TUI with the latest plan file

set -euo pipefail

# Activate venv
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

if [ ! -d "$PROJECT_DIR/venv" ]; then
    echo "Creating venv: $PROJECT_DIR/venv"
    python3 -m venv "$PROJECT_DIR/venv"
fi

source "$PROJECT_DIR/venv/bin/activate"
python -m pip install -e "$PROJECT_DIR" >/dev/null

# Resolve plans directory from Claude settings (fallback to default)
PLANS_DIR="$(
python - << 'PY'
import json
import os
import sys
from pathlib import Path


def warn(message: str) -> None:
    print(message, file=sys.stderr)


def resolve_from_settings(settings_path: Path):
    if not settings_path.exists():
        return None
    try:
        content = settings_path.read_text()
    except OSError as exc:
        print(
            f"Error: Unable to read settings file: {settings_path} ({exc})",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        data = json.loads(content)
    except json.JSONDecodeError as exc:
        print(
            f"Error: Invalid JSON in settings file: {settings_path} ({exc})",
            file=sys.stderr,
        )
        sys.exit(1)
    if not isinstance(data, dict):
        return None
    value = data.get("plansDirectory")
    if value is None:
        return None
    if not isinstance(value, str) or not value.strip():
        warn(
            f"Warning: Invalid plansDirectory in {settings_path}; "
            "falling back to defaults."
        )
        return None
    expanded = os.path.expandvars(os.path.expanduser(value))
    path = Path(expanded)
    if not path.is_absolute():
        path = Path.cwd() / path
    try:
        path = path.resolve()
    except OSError:
        path = path.absolute()
    return str(path)


def main() -> None:
    settings_path = Path.home() / ".claude" / "settings.json"
    resolved = resolve_from_settings(settings_path)
    if resolved:
        print(resolved)
        return
    default_path = Path.home() / ".claude" / "plans"
    print(str(default_path))


if __name__ == "__main__":
    main()
PY
)"

if [ ! -d "$PLANS_DIR" ]; then
    echo "Error: Plans directory not found: $PLANS_DIR"
    echo "Create the directory or set \"plansDirectory\" in ~/.claude/settings.json"
    exit 1
fi

# Find the most recently modified .md file
LATEST_PLAN=$(find "$PLANS_DIR" -name "*.md" -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)

if [ -z "$LATEST_PLAN" ]; then
    echo "No plan files found in $PLANS_DIR"
    echo ""
    echo "Usage: ccplan-review <plan-file.md>"
    exit 1
fi

# Launch the TUI with the latest plan
exec ccplan-review "$LATEST_PLAN"
