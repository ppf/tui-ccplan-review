#!/bin/bash
# Launch plan review TUI with the latest plan file

set -euo pipefail

# Activate venv
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
VENV_DIR="$PROJECT_DIR/venv"

if [ ! -d "$VENV_DIR" ]; then
    echo "Creating venv: $VENV_DIR"
    python3 -m venv "$VENV_DIR"
fi

source "$VENV_DIR/bin/activate"

# Install only when entrypoint is missing (first run after venv creation).
if [ ! -x "$VENV_DIR/bin/ccplan-review" ]; then
    PIP_DISABLE_PIP_VERSION_CHECK=1 python -m pip install -e "$PROJECT_DIR" >/dev/null
fi

# If a plan path was passed as argument, use it directly
if [ -n "${1:-}" ] && [ -f "$1" ]; then
    LATEST_PLAN="$1"
else
    # Resolve latest plan across Claude and Codex.
    if ! LATEST_PLAN="$(python -m tui_ccplan_review.plan_discovery --latest --quiet-missing-codex)"; then
        echo "Error: Unable to locate a plan in Claude or Codex plans directories." >&2
        exit 1
    fi

    if [ -z "$LATEST_PLAN" ]; then
        echo "Error: No plan files found in Claude or Codex plans directories." >&2
        exit 1
    fi

    if [ ! -f "$LATEST_PLAN" ]; then
        echo "Error: Plan file not found: $LATEST_PLAN" >&2
        exit 1
    fi
fi

# Launch the TUI with the latest plan
exec ccplan-review "$LATEST_PLAN"
