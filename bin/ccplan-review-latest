#!/bin/bash
# Launch plan review TUI with the latest plan file

set -euo pipefail

# Activate venv
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

if [ ! -d "$PROJECT_DIR/venv" ]; then
    echo "Creating venv: $PROJECT_DIR/venv"
    python3 -m venv "$PROJECT_DIR/venv"
fi

source "$PROJECT_DIR/venv/bin/activate"
python -m pip install -e "$PROJECT_DIR" >/dev/null

# Find the latest plan in ~/.claude/plans/
PLANS_DIR="${CLAUDE_PLANS_DIR:-$HOME/.claude/plans}"

if [ ! -d "$PLANS_DIR" ]; then
    echo "Error: Plans directory not found: $PLANS_DIR"
    echo "Set CLAUDE_PLANS_DIR environment variable or create ~/.claude/plans/"
    exit 1
fi

# Find the most recently modified .md file
LATEST_PLAN=$(find "$PLANS_DIR" -name "*.md" -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)

if [ -z "$LATEST_PLAN" ]; then
    echo "No plan files found in $PLANS_DIR"
    echo ""
    echo "Usage: ccplan-review <plan-file.md>"
    exit 1
fi

# Launch the TUI with the latest plan
exec ccplan-review "$LATEST_PLAN"
